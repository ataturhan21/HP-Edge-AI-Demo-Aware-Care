# SERVER-ONLY configuration contract for the Aware Care API.
# The API reads environment variables only (apps/api/app/config.py); there is no
# dotenv loader. The deploy tool (infra/deploy/nano_deploy.py) sets the deployed
# values itself. The defaults below are the code's defaults and are safe for mock
# development. Relative paths resolve against the repository root.
# Keep a populated .env outside version control. Do not copy values into a
# browser bundle, VITE_* variable, NEXT_PUBLIC_* variable, or mobile package.

# Allowed modes: mock | local. Mock uses explicitly labeled synthetic fixtures
# and MUST NOT contact ZRT. Local uses the configured ZRT model through the
# runtime adapter, validates its output and fails visibly; it never falls back.
AWARECARE_MODE=mock

# ZRT is the only provider (any other value fails startup). The base URL must be
# loopback: http, a loopback host, an explicit port and no user info (#150).
AWARECARE_MODEL_PROVIDER=zrt
AWARECARE_MODEL_BASE_URL=http://127.0.0.1:8080/v1
# The model ID ZRT serves on this device (ADR-002; recorded in the model
# manifest). Unset in local mode means readiness "unavailable".
AWARECARE_MODEL_ID=
# Must stay false; true fails startup.
AWARECARE_ALLOW_CLOUD_FALLBACK=false

# Observed ZRT proxy authentication is "none", bound to 127.0.0.1 only
# (infra/model-manifest.json). No authentication-disable setting is provided;
# never commit a credential.
# Per-device records. The ZGX Fury's deploy configuration selects the copies in
# infra/fury/ (ADR-018).
AWARECARE_MODEL_MANIFEST=infra/model-manifest.json
AWARECARE_DEVICE_INVENTORY=infra/device-inventory.json
# W06 telemetry list prices and assumptions (ADR-017).
AWARECARE_TELEMETRY_PRICING=infra/telemetry-pricing.json
# #537: the model catalogue. When AWARECARE_MODEL_MANIFEST describes another
# model, the API takes the served model's manifest from its catalogue entry.
AWARECARE_MODEL_CATALOG=infra/models/catalog.json
# Read by demo.sh's hardware helper (app/runtime/hardware.py), not by the API:
# a CUDA toolkit with bin/nvcc to use, a stand-in for /usr/local, and (tests
# only) a stand-in for / with proc/meminfo and the DMI product name.
AWARECARE_CUDA_HOME=
AWARECARE_CUDA_ROOT=
AWARECARE_HW_ROOT=

# Local mode needs the enabled, unexpired reviewed pathway (ADR-003,
# content/pathways/registry.json) and the served model. No evidence corpus is
# approved (ADR-004): local mode does not require one, and possible explanations
# come from the model's general medical knowledge, labeled and uncited (ADR-015).
# Mock mode requires only the synthetic fixture pack.
# Offline means no live evidence refresh or provider lookup at runtime; it is
# the only supported value. RuntimeSnapshot.retrieval_mode reports the actual
# retrieval state using its schema enum, not the literal "offline".
AWARECARE_RETRIEVAL_MODE=offline

# Application queue policy, independent of the inference engine's queue.
AWARECARE_ACTIVE_GENERATION_LIMIT=1
AWARECARE_QUEUED_GENERATION_LIMIT=3
# Return HTTP 429 and Retry-After on saturation.
AWARECARE_QUEUE_RETRY_AFTER_SECONDS=5
AWARECARE_GENERATION_DEADLINE_SECONDS=60
AWARECARE_SCHEMA_REPAIR_LIMIT=1
# Local mode: seconds allowed for the red-flag screen and the concern check of a
# new or edited concern (#153, #154). On timeout both defer; the red-flag screen
# before guidance still runs and fails closed.
AWARECARE_CONCERN_SCREEN_TIMEOUT_SECONDS=20

# Browser access: exact origins, comma-separated (no "*"). Other origins get 403.
AWARECARE_ALLOWED_ORIGINS=http://127.0.0.1:15173
# Development-only exception for plain HTTP over the loopback SSH tunnel; set
# true with TLS.
AWARECARE_COOKIE_SECURE=false
# SQLite database, record and export files (git-ignored).
AWARECARE_DATA_DIR=runtime-data/api

# Presenter gateway key (ADR-005 option A): a file of at least 32 characters.
# Unset means no presenter access. Never commit the key.
AWARECARE_PRESENTER_KEY_FILE=
# Commit of the running build, shown in the runtime snapshot (O01) and the
# telemetry; the deploy tool sets it. Unset reports no commit ("unrecorded" in
# the telemetry).
AWARECARE_APP_COMMIT=
