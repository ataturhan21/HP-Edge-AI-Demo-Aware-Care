# Presenter API (ADR-005 option A, amended by #487: a path of the one gateway instead of a second port). Rendered into
# /tmp/aware-care/presenter-api.conf by 25-aware-care-presenter.sh, and included by web.conf.template's server block,
# only when AWARECARE_PRESENTER_ENABLED=1, /run/secrets/presenter.key is readable and the gateway binds loopback;
# otherwise presenter-api-disabled.conf takes its place. Reached through the same SSH tunnel as the patient pages.
js_import presenter from /etc/nginx/aware-care/presenter.js;
js_set $aware_care_presenter_assertion presenter.mint;

    location /presenter-api/ {
        gzip off;
        # /presenter-api/v1/... is the API's /api/v1/...: the same operations, with the presenter assertion.
        proxy_pass http://127.0.0.1:${AWARECARE_API_PORT}/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        # Fresh signed assertion on every request; any client-supplied value is overwritten.
        proxy_set_header X-AwareCare-Presenter $aware_care_presenter_assertion;
        proxy_read_timeout 90s;
        # A UI hint only (the API authorizes): lets the presenter screens offer a presenter session.
        add_header X-AwareCare-Gateway presenter always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
        add_header Cross-Origin-Opener-Policy same-origin always;
    }
