{
  "name": "aware-care-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "gen:api": "openapi-typescript ../../spec/api/openapi.json -o src/api/schema.ts",
    "test:ui": "NODE_PATH=$PWD/node_modules playwright test",
    "test:device": "NODE_PATH=$PWD/node_modules playwright test -c playwright.devices.config.ts",
    "typecheck:device": "tsc -p ../../tests/devices"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "4.10.3",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
