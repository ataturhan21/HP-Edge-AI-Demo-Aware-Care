{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence",
  "x-spec-version": "2.0",
  "x-handoff-status": "draft-wire-detail",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048,
      "pattern": "^https://"
    },
    "publisher": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "topic_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "maxItems": 50
    },
    "source_updated_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewed_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "review_status": {
      "type": "string",
      "enum": [
        "unreviewed",
        "approved",
        "rejected",
        "expired"
      ]
    },
    "review_expires_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "corpus_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "excerpt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "locator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  },
  "required": [
    "id",
    "source_url",
    "publisher",
    "title",
    "topic_ids",
    "source_updated_at",
    "retrieved_at",
    "reviewed_at",
    "review_status",
    "review_expires_at",
    "corpus_version",
    "content_hash",
    "excerpt",
    "locator"
  ],
  "additionalProperties": false,
  "description": "Schema validity alone never makes an item usable. Clinical support requires approved status, a named review record, current review dates and applicability."
}
