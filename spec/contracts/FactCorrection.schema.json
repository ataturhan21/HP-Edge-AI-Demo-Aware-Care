{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FactCorrection",
  "x-spec-version": "2.0",
  "x-handoff-status": "draft-wire-detail",
  "type": "object",
  "properties": {
    "value": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 2000
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 500
          },
          "maxItems": 50
        }
      ]
    },
    "units": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 100
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "value",
    "units"
  ],
  "additionalProperties": false,
  "description": "User correction is stored separately from original extraction text and source. Preserve unit provenance; never rewrite the original source."
}
