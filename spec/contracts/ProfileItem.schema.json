{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProfileItem",
  "x-spec-version": "2.0",
  "x-handoff-status": "draft-wire-detail",
  "type": "object",
  "properties": {
    "value": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "confirmed_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "value",
    "confirmed_at"
  ],
  "additionalProperties": false,
  "description": "Null confirmation means not current; new-case confirmation remains required even for previously confirmed profile entries."
}
