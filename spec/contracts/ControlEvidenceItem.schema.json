{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ControlEvidenceItem",
  "x-spec-version": "2.0",
  "x-handoff-status": "draft-wire-detail",
  "type": "object",
  "properties": {
    "control_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "status": {
      "type": "string",
      "enum": [
        "verified",
        "failed",
        "unverified"
      ]
    },
    "checked_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "control_id",
    "status",
    "checked_at",
    "evidence_id",
    "summary"
  ],
  "additionalProperties": false
}
