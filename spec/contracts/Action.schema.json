{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Action",
  "x-spec-version": "2.0",
  "x-handoff-status": "draft-wire-detail",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "category": {
      "type": "string",
      "enum": [
        "self_care",
        "seek_care",
        "discuss_with_clinician"
      ]
    },
    "rationale": {
      "type": "string",
      "maxLength": 2000
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "maxItems": 20
    },
    "pathway_rule_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "text",
    "category",
    "rationale",
    "evidence_ids",
    "pathway_rule_id"
  ],
  "additionalProperties": false
}
