{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConfirmedContextWrite",
  "x-spec-version": "2.0",
  "x-handoff-status": "draft-wire-detail",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "value": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 2000
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 500
          },
          "maxItems": 50
        }
      ]
    },
    "units": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "origin": {
      "type": "string",
      "enum": [
        "user",
        "profile"
      ]
    },
    "profile_revision": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "kind",
    "value",
    "units",
    "origin",
    "profile_revision"
  ],
  "additionalProperties": false,
  "description": "No document-origin or arbitrary Fact IDs accepted here. Server checks source profile ownership/revision and records confirmation. Null value remains unknown, not a negative finding."
}
