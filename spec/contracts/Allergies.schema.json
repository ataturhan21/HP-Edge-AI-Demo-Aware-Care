{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Allergies",
  "x-spec-version": "2.0",
  "x-handoff-status": "draft-wire-detail",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "unknown",
        "none_reported",
        "reported"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "ProfileItem.schema.json"
      },
      "maxItems": 50
    }
  },
  "required": [
    "status",
    "items"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "reported"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "items": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "items": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
