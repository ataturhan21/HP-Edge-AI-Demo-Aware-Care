{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event",
  "x-spec-version": "2.0",
  "x-handoff-status": "draft-wire-detail",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_name": {
      "type": "string",
      "enum": [
        "session_started",
        "question_issued",
        "answer_saved",
        "guidance_completed",
        "provider_search_completed",
        "export_downloaded",
        "urgency_interrupted",
        "deletion_completed",
        "service_failed"
      ]
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "requirement_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^R(0[1-9]|[1-3][0-9]|40)$"
      },
      "maxItems": 40
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "duration_ms": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "software_manifest_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "mode": {
      "type": "string",
      "enum": [
        "mock",
        "local"
      ]
    },
    "session_mode": {
      "type": "string",
      "enum": [
        "guest",
        "saved"
      ]
    },
    "consent_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "synthetic": {
      "type": "boolean"
    },
    "slot": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "response_type": {
      "type": "string",
      "enum": [
        "single_choice",
        "multiple_choice",
        "text",
        "scale",
        "duration"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "model_manifest_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "corpus_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "directory_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "retrieval_mode": {
      "type": "string",
      "enum": [
        "local",
        "cached",
        "connected",
        "unavailable"
      ]
    },
    "queue_ms": {
      "type": "number",
      "minimum": 0
    },
    "retrieval_ms": {
      "type": "number",
      "minimum": 0
    },
    "inference_ms": {
      "type": "number",
      "minimum": 0
    },
    "validation_ms": {
      "type": "number",
      "minimum": 0
    },
    "total_ms": {
      "type": "number",
      "minimum": 0
    },
    "validation_result": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "limited"
      ]
    },
    "result_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "data_mode": {
      "type": "string",
      "enum": [
        "real",
        "synthetic"
      ]
    },
    "export_type": {
      "const": "pdf"
    },
    "rule_package_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "synthetic_fixture_category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "scope_type": {
      "type": "string",
      "enum": [
        "case",
        "guest",
        "actor",
        "presenter_run"
      ]
    },
    "store_completion_flags": {
      "type": "object",
      "properties": {
        "database": {
          "type": "boolean"
        },
        "files": {
          "type": "boolean"
        },
        "patient_indexes": {
          "type": "boolean"
        },
        "jobs": {
          "type": "boolean"
        },
        "exports": {
          "type": "boolean"
        },
        "idempotency_cache": {
          "type": "boolean"
        }
      },
      "required": [
        "database",
        "files",
        "patient_indexes",
        "jobs",
        "exports",
        "idempotency_cache"
      ],
      "additionalProperties": false
    },
    "subsystem": {
      "type": "string",
      "enum": [
        "access",
        "database",
        "records",
        "safety",
        "evidence",
        "guidance",
        "providers",
        "exports",
        "privacy",
        "zrt"
      ]
    },
    "retryable": {
      "type": "boolean"
    }
  },
  "required": [
    "event_id",
    "event_name",
    "run_id",
    "requirement_ids",
    "timestamp",
    "duration_ms",
    "status",
    "error_code",
    "software_manifest_id"
  ],
  "additionalProperties": false,
  "description": "Closed content-free schema. Optional fields formalize the master event table. Emit only fields relevant to that event. No arbitrary metadata, health content, names, filenames, prompts, model text, full query URLs or query values."
}
