{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Profile",
  "x-spec-version": "2.0",
  "x-handoff-status": "draft-wire-detail",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "actor_id": {
      "type": "string",
      "format": "uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "age_years": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 130
        },
        {
          "type": "null"
        }
      ]
    },
    "history": {
      "type": "array",
      "items": {
        "$ref": "ProfileItem.schema.json"
      },
      "maxItems": 50
    },
    "medications": {
      "type": "array",
      "items": {
        "$ref": "ProfileItem.schema.json"
      },
      "maxItems": 50
    },
    "allergies": {
      "$ref": "Allergies.schema.json"
    },
    "saved_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "actor_id",
    "revision",
    "age_years",
    "history",
    "medications",
    "allergies",
    "saved_at"
  ],
  "additionalProperties": false
}
