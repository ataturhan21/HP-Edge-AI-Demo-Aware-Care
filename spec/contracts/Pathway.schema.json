{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pathway",
  "x-spec-version": "2.0",
  "x-handoff-status": "draft-wire-detail",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "supported_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "maxItems": 100
    },
    "required_fact_keys": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "maxItems": 100
    },
    "urgent_rules": {
      "type": "array",
      "items": {
        "$ref": "PathwayRule.schema.json"
      },
      "maxItems": 100
    },
    "eligible_questions": {
      "type": "array",
      "items": {
        "$ref": "PathwayQuestionRef.schema.json"
      },
      "maxItems": 100
    },
    "stop_rules": {
      "$ref": "PathwayStopRules.schema.json"
    },
    "approved_output_templates": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "maxItems": 100
    },
    "reviewers": {
      "type": "array",
      "items": {
        "$ref": "Reviewer.schema.json"
      },
      "maxItems": 20
    },
    "review_date": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "expires_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "enabled": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "version",
    "supported_scope",
    "required_fact_keys",
    "urgent_rules",
    "eligible_questions",
    "stop_rules",
    "approved_output_templates",
    "reviewers",
    "review_date",
    "expires_at",
    "enabled"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        },
        "required": [
          "enabled"
        ]
      },
      "then": {
        "properties": {
          "reviewers": {
            "minItems": 1,
            "items": {
              "properties": {
                "decision": {
                  "const": "approved"
                }
              }
            }
          },
          "review_date": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "approved_output_templates": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
