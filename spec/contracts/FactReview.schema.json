{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FactReview",
  "x-spec-version": "2.0",
  "x-handoff-status": "draft-wire-detail",
  "type": "object",
  "properties": {
    "expected_revision": {
      "type": "integer",
      "minimum": 1
    },
    "action": {
      "type": "string",
      "enum": [
        "confirm",
        "reject",
        "correct"
      ]
    },
    "corrected_value": {
      "$ref": "FactCorrection.schema.json"
    }
  },
  "required": [
    "expected_revision",
    "action"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "correct"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "corrected_value"
        ]
      },
      "else": {
        "not": {
          "required": [
            "corrected_value"
          ]
        }
      }
    }
  ]
}
