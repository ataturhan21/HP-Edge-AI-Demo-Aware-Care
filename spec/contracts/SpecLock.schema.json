{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpecLock",
  "x-spec-version": "2.0",
  "x-handoff-status": "draft-wire-detail",
  "type": "object",
  "properties": {
    "spec_version": {
      "const": "2.0"
    },
    "normalized_spec_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "contracts_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "screen_registry_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "traceability_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "spec_version",
    "normalized_spec_sha256",
    "contracts_sha256",
    "screen_registry_sha256",
    "traceability_sha256"
  ],
  "additionalProperties": false
}
